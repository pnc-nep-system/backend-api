APP_NAME="NEP Programme API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------------------
# Database
# -------------------------------------------------------
# Development: use sqlite (no server required)
#   DB_CONNECTION=sqlite
# Production: use mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nep_system
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------------------
# Session
# -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# -------------------------------------------------------
# Cache & Queue (Redis)
# -------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -------------------------------------------------------
# Broadcasting (Laravel Reverb)
# -------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

# Vite exposes these to the frontend Echo config
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -------------------------------------------------------
# Filesystem & Storage
# -------------------------------------------------------
FILESYSTEM_DISK=local

# -------------------------------------------------------
# Mail (Gmail SMTP)
# -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@nep-system.org"
MAIL_FROM_NAME="NEP Cambodia"

# -------------------------------------------------------
# AI Provider (required for advisory note generation)
#
# Only ONE provider block should be active at a time.
# After switching providers:
#   1. Comment out the old block below
#   2. Uncomment the new block
#   3. Update config/services.php to use the new key prefix
#   4. Add the AppServiceProvider binding (see README)
#   5. Run: php artisan config:clear
# -------------------------------------------------------

# --- Option A: Groq (current default) ---
# Docs: https://console.groq.com/docs
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30
GROQ_RETRY_ATTEMPTS=2
GROQ_RETRY_DELAY=500

# --- Option B: Claude (Anthropic) ---
# Docs: https://docs.anthropic.com/en/api/getting-started
# Uncomment and fill in when switching to Claude:
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_TIMEOUT=30
CLAUDE_RETRY_ATTEMPTS=2
CLAUDE_RETRY_DELAY=500

# -------------------------------------------------------
# ImageKit (required for organisation logo uploads)
# Get credentials at: https://imagekit.io/dashboard/developer/api-keys
# -------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# -------------------------------------------------------
# AWS S3 (optional — alternative file storage)
# -------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -------------------------------------------------------
# Sanctum & Frontend
# -------------------------------------------------------
# Add all frontend origins that need Sanctum cookie auth
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

VITE_APP_NAME="${APP_NAME}"
L5_SWAGGER_USE_ABSOLUTE_PATH=false
