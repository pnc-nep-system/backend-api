{
    "openapi": "3.0.0",
    "info": {
        "title": "NEP Programme API",
        "description": "API documentation for authentication and programme entry management",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Local development server"
        }
    ],
    "paths": {
        "/programme-entries": {
            "post": {
                "tags": [
                    "Programme Entries"
                ],
                "summary": "Create a new programme entry",
                "description": "Creates a Section 1 programme entry, automatically scoped to the authenticated user's organisation.",
                "operationId": "a73ca51d62e59cc204ac25ab800d03f4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "programme_name",
                                    "start_date"
                                ],
                                "properties": {
                                    "programme_name": {
                                        "type": "string",
                                        "example": "Youth Skills Initiative"
                                    },
                                    "start_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-01-15"
                                    },
                                    "end_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-12-31",
                                        "nullable": true
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "A short summary of the programme"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Entry created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Programme entry created."
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/ProgrammeEntry"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "The given data was invalid."
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sessionAuth": []
                    }
                ]
            }
        },
        "/programme-entries/{id}": {
            "get": {
                "tags": [
                    "Programme Entries"
                ],
                "summary": "Get a single programme entry",
                "description": "Retrieves one programme entry. Only NEP Admins or the owning organisation may view.",
                "operationId": "40538f9fdaaa03c22fdff74dab914822",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Programme entry ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Entry retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/ProgrammeEntry"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Not authorized to view this entry",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "You are not authorized to view this entry."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "404": {
                        "description": "Entry not found"
                    }
                },
                "security": [
                    {
                        "sessionAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Programme Entries"
                ],
                "summary": "Update an existing programme entry",
                "description": "Updates Section 1 fields. Only NEP Admins or the owning organisation may edit.",
                "operationId": "0fde261313ff4dc167938c77f661f2cb",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Programme entry ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "programme_name": {
                                        "type": "string",
                                        "example": "Youth Skills Initiative v2"
                                    },
                                    "start_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-02-01"
                                    },
                                    "end_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-12-31",
                                        "nullable": true
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Updated summary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Entry updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Programme entry updated."
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/ProgrammeEntry"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Not authorized to update this entry",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "You are not authorized to update this entry."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "404": {
                        "description": "Entry not found"
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sessionAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "ProgrammeEntry": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 45
                    },
                    "organisation_id": {
                        "type": "integer",
                        "example": 12
                    },
                    "programme_name": {
                        "type": "string",
                        "example": "Youth Skills Initiative"
                    },
                    "start_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-01-15"
                    },
                    "end_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-12-31",
                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "example": "A short summary of the programme"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sessionAuth": {
                "type": "apiKey",
                "name": "laravel_session",
                "in": "cookie"
            }
        }
    },
    "tags": [
        {
            "name": "Programme Entries",
            "description": "Programme Entries"
        }
    ]
}